# A committed credential is the one mistake in this repo that actually
# matters, so JSON is blocked by default and re-allowed only where data is
# meant to live. Order matters here: later rules win.
*.json
!data/*.json
# The proof behind each event's cost, built by scripts/build_event_cost_lines.py.
!site/event_cost_lines.json
# Ryan Peterson's sets and demos for the RP tab, a dated HubSpot pull:
# company names and record ids only.
!site/rp_sets.json
# Which engagement band each account was in on the export date, for the
# Upgrade list's campaign: Stripe customer ids and a band only.
!site/engagement_bands.json
# The 500+ churn model's score for each $500-799 account on the Upgrade list
# (Josh, 11 Nov 2026): Stripe customer ids and a score only.
!site/churn_risk_500.json

# Re-block the credential filenames even inside data/, because the
# negation above would otherwise let data/key.json through.
key.json
credentials.json
service-account*.json
*-key.json
*.pem

# Compressed data files are not matched by *.json and stay tracked.

__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
.DS_Store

# Written by scripts/validate_data.py when a check fails. A run artifact,
# not something to keep.
validation-report.md

# Rendered video and the frame grabs taken to review it. Both are regenerated
# from the composition by the HyperFrames CLI, so they are build output rather
# than source, and one render is 5.7MB that would sit in history for good.
videos/**/renders/
videos/**/snapshots/
